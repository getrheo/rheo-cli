{
  "name": "@getrheo/cli",
  "version": "2.6.0",
  "type": "module",
  "description": "Rheo CLI — workspace automation for apps, flows, channels, experiments, analytics, rollouts, and media.",
  "bin": {
    "rheo": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@rheo/config": "workspace:*",
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "rheo": "./dist/index.js"
    }
  },
  "homepage": "https://docs.getrheo.io/docs/developer-guide/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getrheo/rheo-cli.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/getrheo/rheo-cli/issues"
  }
}
